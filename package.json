{
  "name": "def-game",
  "version": "5.0.1",
  "description": "Game definition contracts and an in-memory simulator for turn-based games",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "typecheck": "tsc --noEmit",
